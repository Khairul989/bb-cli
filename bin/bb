#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.0"
BB_API_BASE="https://api.bitbucket.org/2.0"
BB_CONFIG_FILE="$HOME/.config/bb/config"

# ---------------------------------------------------------------------------
# Tiny helpers — consistent error/warning prefixes; portable URL opener
# ---------------------------------------------------------------------------
_die()  { echo "error: $*" >&2; exit 1; }
_warn() { echo "warning: $*" >&2; }

_open_url() {
  if command -v open &>/dev/null; then
    open "$1"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "$1"
  else
    echo "Visit: $1"
  fi
}

# Extract a human-readable error message from a Bitbucket API JSON body
_api_error_msg() {
  local body="$1" status="$2"
  printf '%s' "$body" | jq -r --arg s "$status" '.error.message // .error // "HTTP \($s)"' 2>/dev/null || printf 'HTTP %s' "$status"
}

# ---------------------------------------------------------------------------
# Color support — suppressed when NO_COLOR is set or stdout is not a tty
# ---------------------------------------------------------------------------
if [ -z "${NO_COLOR:-}" ] && [ -t 1 ]; then
  C_RESET='\033[0m'
  C_YELLOW='\033[0;33m'
  C_GREEN='\033[0;32m'
  C_RED='\033[0;31m'
  C_GRAY='\033[0;90m'
  C_BOLD='\033[1m'
else
  C_RESET='' C_YELLOW='' C_GREEN='' C_RED='' C_GRAY='' C_BOLD=''
fi

# ---------------------------------------------------------------------------
# Startup: check required tools
# ---------------------------------------------------------------------------
check_deps() {
  local missing=0 dep
  for dep in curl jq git; do
    if ! command -v "$dep" &>/dev/null; then
      echo "error: '$dep' is required but not installed." >&2
      echo "  Install: brew install $dep" >&2
      missing=1
    fi
  done
  [ "$missing" -eq 0 ] || exit 1
}

# ---------------------------------------------------------------------------
# Auth: load creds from env (wins) or ~/.config/bb/config (fallback)
# Sets BB_CREDS_SOURCE=env|config so callers can report where creds came from.
# Call lazily — only before API commands. auth login/logout/help/version skip this.
# ---------------------------------------------------------------------------
BB_CREDS_SOURCE=""

load_creds() {
  if [[ -n "${BB_EMAIL:-}" && -n "${BB_TOKEN:-}" ]]; then
    BB_CREDS_SOURCE="env"
  elif [[ -f "$BB_CONFIG_FILE" ]]; then
    # shellcheck disable=SC1091
    source "$BB_CONFIG_FILE"
    BB_CREDS_SOURCE="config"
  fi
  [[ -n "${BB_EMAIL:-}" && -n "${BB_TOKEN:-}" ]] || _die "Not logged in. Run: bb auth login"
}

# ---------------------------------------------------------------------------
# Auth subcommands: login, status, logout
# ---------------------------------------------------------------------------
auth_login() {
  echo "Opening Atlassian token page in your browser..."
  _open_url "https://id.atlassian.com/manage-profile/security/api-tokens"

  echo ""
  echo "Create a token with the following scopes:"
  echo "  - read:repository:bitbucket"
  echo "  - read:pullrequest:bitbucket"
  echo "  - write:pullrequest:bitbucket"
  echo ""

  local email token
  printf 'Atlassian email: '
  read -r email
  [[ -n "$email" && "$email" == *@* ]] || _die "invalid email address"

  printf 'API token (hidden): '
  read -rs token
  printf '\n'
  [ -n "$token" ] || _die "token cannot be empty"

  if try_detect_workspace_slug; then
    local slug="$DETECTED_WORKSPACE"
    verify_workspace_creds "$email" "$token" "$slug"
    if [ "$VERIFY_STATUS" -ge 200 ] && [ "$VERIFY_STATUS" -lt 300 ]; then
      local repo_count
      repo_count=$(printf '%s' "$VERIFY_BODY" | jq -r '.size // 0' 2>/dev/null || echo "0")
      printf 'Verified against workspace: %s. Repository access confirmed (%s repos visible).\n' "$slug" "$repo_count"
    elif [ "$VERIFY_STATUS" -eq 401 ] || [ "$VERIFY_STATUS" -eq 403 ]; then
      _die "$(_api_error_msg "$VERIFY_BODY" "$VERIFY_STATUS")"
    elif [ "$VERIFY_STATUS" -eq 404 ]; then
      printf "Workspace '%s' not found or no access. Saving creds anyway — run a 'bb pr ...' command from a workspace you have access to, to confirm.\n" "$slug"
    else
      _die "authentication failed — $(_api_error_msg "$VERIFY_BODY" "$VERIFY_STATUS")"
    fi
  else
    printf 'No Bitbucket workspace detected in current directory.\n'
    printf "Skipping verification — credentials will be tested by your first 'bb pr ...' command.\n"
  fi

  mkdir -p "$(dirname "$BB_CONFIG_FILE")"
  ( umask 077 && printf 'BB_EMAIL=%s\nBB_TOKEN=%s\n' "$email" "$token" > "$BB_CONFIG_FILE" )
  chmod 600 "$BB_CONFIG_FILE"

  echo "Saved to ~/.config/bb/config."
}

auth_status() {
  # Resolve creds without calling load_creds (which exits early with error)
  local email="" token="" creds_via=""
  if [[ -n "${BB_EMAIL:-}" && -n "${BB_TOKEN:-}" ]]; then
    email="$BB_EMAIL"
    token="$BB_TOKEN"
    creds_via="env"
  elif [[ -f "$BB_CONFIG_FILE" ]]; then
    # shellcheck disable=SC1091
    source "$BB_CONFIG_FILE"
    email="${BB_EMAIL:-}"
    token="${BB_TOKEN:-}"
    creds_via="config"
  fi

  if [[ -z "$email" || -z "$token" ]]; then
    echo "Not logged in. Run \`bb auth login\`."
    exit 1
  fi

  if try_detect_workspace_slug; then
    local slug="$DETECTED_WORKSPACE"
    verify_workspace_creds "$email" "$token" "$slug"
    if [ "$VERIFY_STATUS" -ge 200 ] && [ "$VERIFY_STATUS" -lt 300 ]; then
      local repo_count
      repo_count=$(printf '%s' "$VERIFY_BODY" | jq -r '.size // 0' 2>/dev/null || echo "0")
      printf 'Logged in via %s. Verified against workspace: %s (%s repos visible).\n' "$creds_via" "$slug" "$repo_count"
    elif [ "$VERIFY_STATUS" -eq 401 ] || [ "$VERIFY_STATUS" -eq 403 ]; then
      printf 'Logged in via %s, but credentials rejected: %s. Re-run `bb auth login`.\n' "$creds_via" "$(_api_error_msg "$VERIFY_BODY" "$VERIFY_STATUS")" >&2
      exit 1
    elif [ "$VERIFY_STATUS" -eq 404 ]; then
      printf "Logged in via %s. Workspace '%s' not visible — verify your token has access.\n" "$creds_via" "$slug"
    else
      _die "authentication check failed — $(_api_error_msg "$VERIFY_BODY" "$VERIFY_STATUS")"
    fi
  else
    printf 'Logged in via %s. (No workspace context for verification — run from a Bitbucket repo to verify.)\n' "$creds_via"
  fi
}

auth_logout() {
  if [[ -f "$BB_CONFIG_FILE" ]]; then
    rm -f "$BB_CONFIG_FILE"
    echo "Removed ~/.config/bb/config."
  else
    echo "No config file found at ~/.config/bb/config."
  fi

  if [[ -n "${BB_EMAIL:-}" || -n "${BB_TOKEN:-}" ]]; then
    _warn "BB_EMAIL/BB_TOKEN still set in your shell environment — unset them manually if needed."
  fi
}

auth_dispatch() {
  local subcmd="${1:-}"
  [ -n "$subcmd" ] || { usage_auth; exit 1; }
  shift

  case "$subcmd" in
    login)   auth_login   "$@" ;;
    status)  auth_status  "$@" ;;
    logout)  auth_logout  "$@" ;;
    *)
      echo "error: unknown auth subcommand '$subcmd'" >&2
      usage_auth
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# API helpers.
#   bb_api_raw  — generic curl+status-split; no Content-Type assumed.
#                 Used for diff (text/plain) and other non-JSON endpoints.
#   bb_api      — adds Content-Type: application/json; for normal API calls.
# Both: returns body on stdout, exits 1 on non-2xx with the API error message.
# ---------------------------------------------------------------------------
bb_api_raw() {
  local method="$1"; shift
  local path="$1"; shift
  local url

  # Allow full URLs (for pagination .next links) or relative paths
  if [[ "$path" == https://* ]]; then
    url="$path"
  else
    url="${BB_API_BASE}${path}"
  fi

  local raw
  # The trailing newline separator lets us split body from status robustly
  raw=$(curl -sS -w $'\n%{http_code}' -X "$method" \
    -u "${BB_EMAIL}:${BB_TOKEN}" \
    "$@" "$url") || _die "curl failed (network error or bad TLS)"

  local status="${raw##*$'\n'}"
  local body="${raw%$'\n'*}"

  if [ "$status" -lt 200 ] || [ "$status" -ge 300 ]; then
    _die "Bitbucket API returned $status — $(_api_error_msg "$body" "$status")"
  fi

  printf '%s' "$body"
}

bb_api() {
  local method="$1"; shift
  local path="$1"; shift
  bb_api_raw "$method" "$path" -H "Content-Type: application/json" "$@"
}

# ---------------------------------------------------------------------------
# Verify creds against a workspace using the repositories endpoint
# (CHANGE-2770-safe: only needs read:repository:bitbucket scope).
# Args: email token slug
# Sets globals: VERIFY_STATUS, VERIFY_BODY
# ---------------------------------------------------------------------------
verify_workspace_creds() {
  local raw
  raw=$(curl -sS -w $'\n%{http_code}' \
    -u "${1}:${2}" \
    "${BB_API_BASE}/repositories/${3}?pagelen=1") || _die "curl failed (network error or bad TLS)"
  VERIFY_STATUS="${raw##*$'\n'}"
  VERIFY_BODY="${raw%$'\n'*}"
}

# ---------------------------------------------------------------------------
# Try to detect workspace slug from the current directory's git remote.
# Soft-fail: sets DETECTED_WORKSPACE and returns 0 on success, returns 1 if
# not in a git repo or origin is not a Bitbucket URL. Does NOT exit.
# ---------------------------------------------------------------------------
DETECTED_WORKSPACE=""
try_detect_workspace_slug() {
  local remote_url
  remote_url=$(git remote get-url origin 2>/dev/null) || return 1

  if [[ "$remote_url" =~ bitbucket\.org[:/]([^/]+)/([^/]+)(\.git)?$ ]]; then
    DETECTED_WORKSPACE="${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

# ---------------------------------------------------------------------------
# Parse git remote to extract workspace + repo slug
# ---------------------------------------------------------------------------
detect_repo() {
  local remote_url
  remote_url=$(git remote get-url origin 2>/dev/null) || {
    echo "error: no git remote 'origin' found." >&2
    exit 1
  }

  # ssh: git@bitbucket.org:WORKSPACE/REPO.git
  # https: https://user@bitbucket.org/WORKSPACE/REPO.git
  if [[ "$remote_url" =~ bitbucket\.org[:/]([^/]+)/([^/]+)(\.git)?$ ]]; then
    BB_WORKSPACE="${BASH_REMATCH[1]}"
    BB_REPO="${BASH_REMATCH[2]%.git}"
  else
    echo "error: origin is not a Bitbucket URL: $remote_url" >&2
    echo "  Expected: git@bitbucket.org:WORKSPACE/REPO.git or https://...@bitbucket.org/WORKSPACE/REPO.git" >&2
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Fetch the repo's mainbranch name from the API
# ---------------------------------------------------------------------------
get_default_branch() {
  local info
  info=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}")
  printf '%s' "$info" | jq -r '.mainbranch.name'
}

# ---------------------------------------------------------------------------
# Color-code a PR state string
# ---------------------------------------------------------------------------
colorize_state() {
  local state="$1"
  local upper
  upper=$(printf '%s' "$state" | tr '[:lower:]' '[:upper:]')
  case "$upper" in
    OPEN)      printf '%b%s%b' "$C_YELLOW" "$state" "$C_RESET" ;;
    MERGED)    printf '%b%s%b' "$C_GREEN"  "$state" "$C_RESET" ;;
    DECLINED)  printf '%b%s%b' "$C_RED"    "$state" "$C_RESET" ;;
    *)         printf '%b%s%b' "$C_GRAY"   "$state" "$C_RESET" ;; # SUPERSEDED, draft
  esac
}

# ---------------------------------------------------------------------------
# Resolve a reviewer username to a Bitbucket UUID.
# Bitbucket needs UUIDs (with curly braces), not display names, in PR payloads.
# Tries three sources in order, falling through silently on 403/404:
#   1. workspace member lookup   (needs workspace-member scope — often 403)
#   2. direct /users/{name}      (account_id or username)
#   3. repo default-reviewers    (no extra scope; matches name/nickname/fragment)
# Accepts a username, nickname, account_id, uuid, or display-name fragment.
# Prints the uuid and returns 0 on the first hit; returns 1 if all sources miss.
# ---------------------------------------------------------------------------
resolve_reviewer_uuid() {
  local username="$1"
  local resp status body uuid

  # 1) Workspace member lookup. May 403 when the token lacks the member scope —
  #    do NOT abort; fall through to the next source.
  resp=$(curl -sS -w $'\n%{http_code}' \
    -u "${BB_EMAIL}:${BB_TOKEN}" \
    "${BB_API_BASE}/workspaces/${BB_WORKSPACE}/members/${username}" 2>/dev/null) || resp=""
  if [ -n "$resp" ]; then
    status="${resp##*$'\n'}"
    body="${resp%$'\n'*}"
    if [ "$status" -ge 200 ] && [ "$status" -lt 300 ]; then
      uuid=$(printf '%s' "$body" | jq -r '.user.uuid // empty')
      [ -n "$uuid" ] && printf '%s' "$uuid" && return 0
    fi
  fi

  # 2) Direct user lookup (works for account_id / username).
  resp=$(curl -sS -w $'\n%{http_code}' \
    -u "${BB_EMAIL}:${BB_TOKEN}" \
    "${BB_API_BASE}/users/${username}" 2>/dev/null) || resp=""
  if [ -n "$resp" ]; then
    status="${resp##*$'\n'}"
    body="${resp%$'\n'*}"
    if [ "$status" -ge 200 ] && [ "$status" -lt 300 ]; then
      uuid=$(printf '%s' "$body" | jq -r '.uuid // empty')
      [ -n "$uuid" ] && printf '%s' "$uuid" && return 0
    fi
  fi

  # 3) Default-reviewers fallback — no workspace-member scope required.
  #    Match input (case-insensitive) on uuid, account_id, nickname, or a
  #    display-name fragment. This is what resolves users on scope-limited tokens.
  resp=$(curl -sS -w $'\n%{http_code}' \
    -u "${BB_EMAIL}:${BB_TOKEN}" \
    "${BB_API_BASE}/repositories/${BB_WORKSPACE}/${BB_REPO}/default-reviewers?pagelen=100" 2>/dev/null) || resp=""
  if [ -n "$resp" ]; then
    status="${resp##*$'\n'}"
    body="${resp%$'\n'*}"
    if [ "$status" -ge 200 ] && [ "$status" -lt 300 ]; then
      uuid=$(printf '%s' "$body" | jq -r --arg q "$username" '
        ($q | ascii_downcase) as $ql
        | [ .values[]?
            | select(
                (.uuid == $q)
                or (.account_id == $q)
                or ((.nickname // "" | ascii_downcase) == $ql)
                or ((.display_name // "" | ascii_downcase) | contains($ql))
              )
            | .uuid
          ][0] // empty')
      [ -n "$uuid" ] && printf '%s' "$uuid" && return 0
    fi
  fi

  return 1
}

# ---------------------------------------------------------------------------
# pr create
# ---------------------------------------------------------------------------
pr_create() {
  local title="" body="" body_file="" dest="" draft=false reviewers_csv=""
  local fill=false web=false has_title=false has_body=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --title)       title="$2";          has_title=true; shift 2 ;;
      --body)        body="$2";           has_body=true;  shift 2 ;;
      --body-file)   body_file="$2";      has_body=true;  shift 2 ;;
      --dest)        dest="$2";           shift 2 ;;
      --draft)       draft=true;          shift   ;;
      --reviewers)   reviewers_csv="$2";  shift 2 ;;
      --fill)        fill=true;           shift   ;;
      --web)         web=true;            shift   ;;
      *) echo "unknown flag: $1" >&2; usage_pr; exit 1 ;;
    esac
  done

  local source_branch
  source_branch=$(git branch --show-current)
  [ -n "$source_branch" ] || { echo "error: could not determine current branch (detached HEAD?)" >&2; exit 1; }

  if [ -n "$body_file" ]; then
    [ -f "$body_file" ] || { echo "error: body file not found: $body_file" >&2; exit 1; }
    body=$(< "$body_file")
  fi

  if [ -z "$dest" ]; then
    dest=$(get_default_branch)
  fi

  # --fill: derive title from latest commit subject, body from commit log since dest
  if [ "$fill" = true ]; then
    if [ "$has_title" = false ]; then
      title=$(git log -1 --format=%s)
    fi
    if [ "$has_body" = false ]; then
      body=$(git log "${dest}..HEAD" --format='- %s')
    fi
  fi

  # --web: open Bitbucket compare page in browser instead of POSTing
  if [ "$web" = true ]; then
    local encoded_src encoded_dst
    encoded_src=$(jq -rn --arg b "$source_branch" '@uri $b')
    encoded_dst=$(jq -rn --arg b "$dest" '@uri $b')
    local web_url="https://bitbucket.org/${BB_WORKSPACE}/${BB_REPO}/pull-requests/new?source=${encoded_src}&dest=${encoded_dst}"
    _open_url "$web_url"
    printf '%s\n' "$web_url"
    return
  fi

  [ -n "$title" ] || { echo "error: --title is required (or use --fill to derive from commits)" >&2; exit 1; }

  # Build reviewers JSON array — resolve each username to UUID
  local reviewers_json="[]"
  if [ -n "$reviewers_csv" ]; then
    local uuids_arr="[]"
    IFS=',' read -ra reviewer_names <<< "$reviewers_csv"
    for name in "${reviewer_names[@]}"; do
      name="${name// /}"  # trim spaces
      local uuid
      if uuid=$(resolve_reviewer_uuid "$name"); then
        # Bitbucket UUID includes curly braces: {uuid}
        uuids_arr=$(printf '%s' "$uuids_arr" | jq --arg u "$uuid" '. + [{"uuid": $u}]')
      else
        echo "warning: could not resolve reviewer '$name' — skipping" >&2
      fi
    done
    reviewers_json="$uuids_arr"
  fi

  # Build payload using jq so user input is never string-concatenated into JSON
  local payload
  payload=$(jq -n \
    --arg title   "$title" \
    --arg desc    "$body" \
    --arg src     "$source_branch" \
    --arg dst     "$dest" \
    --argjson draft "$draft" \
    --argjson reviewers "$reviewers_json" \
    '{
      title:       $title,
      description: $desc,
      source:      {branch: {name: $src}},
      destination: {branch: {name: $dst}},
      draft:       $draft,
      reviewers:   $reviewers
    }')

  local resp
  resp=$(bb_api POST "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests" \
    --data "$payload")

  local pr_id pr_url pr_state
  IFS=$'\t' read -r pr_id pr_url pr_state <<<"$(printf '%s' "$resp" \
    | jq -r '[.id, .links.html.href, .state] | @tsv')"

  printf '%bPR #%s created%b (%s)\n' "$C_BOLD" "$pr_id" "$C_RESET" "$(colorize_state "$pr_state")"
  printf 'Title:  %s\n' "$title"
  printf 'Branch: %s → %s\n' "$source_branch" "$dest"
  printf 'URL:    %s\n' "$pr_url"
}

# ---------------------------------------------------------------------------
# pr list
# ---------------------------------------------------------------------------
pr_list() {
  local state="open" json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --state) state="$2"; shift 2 ;;
      --mine)  echo "error: --mine is no longer supported (CHANGE-2770). Use --author USERNAME instead (coming v0.2)." >&2; exit 1 ;;
      --json)  json_out=true; shift ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done

  local upper_state
  upper_state=$(printf '%s' "$state" | tr '[:lower:]' '[:upper:]')

  # States to query — "all" expands to all four states
  local states_to_query
  if [ "$upper_state" = "ALL" ]; then
    states_to_query="OPEN MERGED DECLINED SUPERSEDED"
  else
    states_to_query="$upper_state"
  fi

  # Only first page for v0.1 — paginated API; first 50 results per state shown
  local pages=()
  for s in $states_to_query; do
    local page_data
    page_data=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests?state=${s}&pagelen=50")
    pages+=("$(printf '%s' "$page_data" | jq -c '.values')")
  done
  local combined
  combined=$(printf '%s\n' "${pages[@]}" | jq -s 'add // []')

  if [ "$json_out" = true ]; then
    printf '%s\n' "$combined"
    return
  fi

  # Human-readable table: #ID  STATE  TITLE(truncated)  AUTHOR  SRC→DST
  printf '%s' "$combined" | jq -r '.[] | [
    (.id | tostring),
    .state,
    (.title | if length > 45 then .[0:45] + "…" else . end),
    .author.display_name,
    (.source.branch.name + " → " + .destination.branch.name)
  ] | @tsv' | while IFS=$'\t' read -r pr_id st title author branches; do
    printf '%b#%-5s%b  %-12s  %-48s  %-20s  %s\n' \
      "$C_BOLD" "$pr_id" "$C_RESET" \
      "$(colorize_state "$st")" \
      "$title" \
      "$author" \
      "$branches"
  done
}

# ---------------------------------------------------------------------------
# pr view
# ---------------------------------------------------------------------------
pr_view() {
  local pr_id="" json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=true; shift ;;
      -*)     echo "unknown flag: $1" >&2; exit 1 ;;
      *)      pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  local resp
  resp=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}")

  if [ "$json_out" = true ]; then
    printf '%s\n' "$resp"
    return
  fi

  # Single @tsv pass for one-line fields; description stays separate (may be multiline)
  local title state author src dst web_url reviewers description
  IFS=$'\t' read -r title state author src dst web_url reviewers <<<"$(printf '%s' "$resp" \
    | jq -r '[.title, .state, .author.display_name, .source.branch.name, .destination.branch.name, .links.html.href, ([.reviewers[]?.display_name] | join(", "))] | @tsv')"
  description=$(printf '%s' "$resp" | jq -r '.description // ""')

  printf '%b#%s — %s%b\n' "$C_BOLD" "$pr_id" "$title" "$C_RESET"
  printf 'State:     %s\n' "$(colorize_state "$state")"
  printf 'Author:    %s\n' "$author"
  printf 'Branch:    %s → %s\n' "$src" "$dst"
  printf 'Reviewers: %s\n' "${reviewers:-none}"
  printf 'URL:       %s\n' "$web_url"
  if [ -n "$description" ]; then
    printf '\nDescription:\n%s\n' "$description"
  fi
}

# ---------------------------------------------------------------------------
# pr comment
# ---------------------------------------------------------------------------
pr_comment() {
  local pr_id="" body="" body_file=""

  # First non-flag arg is the PR id
  while [ $# -gt 0 ]; do
    case "$1" in
      --body)      body="$2";      shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      -*)          echo "unknown flag: $1" >&2; exit 1 ;;
      *)           pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  if [ -n "$body_file" ]; then
    [ -f "$body_file" ] || { echo "error: body file not found: $body_file" >&2; exit 1; }
    body=$(< "$body_file")
  fi

  [ -n "$body" ] || { echo "error: --body or --body-file is required" >&2; exit 1; }

  local payload
  payload=$(jq -n --arg text "$body" '{"content": {"raw": $text}}')

  local resp
  resp=$(bb_api POST "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/comments" \
    --data "$payload")

  local comment_id
  comment_id=$(printf '%s' "$resp" | jq -r '.id')
  printf 'Comment #%s posted on PR #%s\n' "$comment_id" "$pr_id"
}

# ---------------------------------------------------------------------------
# pr diff — raw diff text, not JSON
# ---------------------------------------------------------------------------
pr_diff() {
  local pr_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*)  echo "unknown flag: $1" >&2; exit 1 ;;
      *)   pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || _die "PR id is required"

  # Diff endpoint returns text/plain — bb_api_raw skips the JSON Content-Type
  printf '%s\n' "$(bb_api_raw GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/diff")"
}

# ---------------------------------------------------------------------------
# pr checks — build statuses
# ---------------------------------------------------------------------------
pr_checks() {
  local pr_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*)  echo "unknown flag: $1" >&2; exit 1 ;;
      *)   pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  local resp
  resp=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/statuses")

  printf '%s' "$resp" | jq -r '.values[] | [.state, .name, .url] | @tsv' \
  | while IFS=$'\t' read -r st name url; do
    local color
    case "$st" in
      SUCCESSFUL) color="$C_GREEN"  ;;
      FAILED)     color="$C_RED"    ;;
      INPROGRESS) color="$C_YELLOW" ;;
      *)          color="$C_GRAY"   ;;
    esac
    printf '%b%-12s%b  %-40s  %s\n' "$color" "$st" "$C_RESET" "$name" "$url"
  done
}

# ---------------------------------------------------------------------------
# pr open — open PR URL in system browser
# ---------------------------------------------------------------------------
pr_open() {
  local pr_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*)  echo "unknown flag: $1" >&2; exit 1 ;;
      *)   pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || _die "PR id is required"

  local pr_url="https://bitbucket.org/${BB_WORKSPACE}/${BB_REPO}/pull-requests/${pr_id}"
  _open_url "$pr_url"
  printf 'Opened: %s\n' "$pr_url"
}

# ---------------------------------------------------------------------------
# pr merge
# ---------------------------------------------------------------------------
pr_merge() {
  local pr_id="" strategy="merge_commit" strategy_set=false
  local close_branch=false message="" json_out=false
  local mutex_err="strategy flags are mutually exclusive (--merge, --squash, --fast-forward)"

  while [ $# -gt 0 ]; do
    case "$1" in
      --merge)
        [ "$strategy_set" = true ] && _die "$mutex_err"
        strategy="merge_commit"; strategy_set=true; shift ;;
      --squash)
        [ "$strategy_set" = true ] && _die "$mutex_err"
        strategy="squash"; strategy_set=true; shift ;;
      --fast-forward)
        [ "$strategy_set" = true ] && _die "$mutex_err"
        strategy="fast_forward"; strategy_set=true; shift ;;
      --delete-branch) close_branch=true; shift ;;
      --message)       message="$2"; shift 2 ;;
      --json)          json_out=true; shift ;;
      -*)              echo "unknown flag: $1" >&2; exit 1 ;;
      *)               pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  # Reject non-OPEN PRs client-side so users get the actual state, not a 405.
  local preflight
  preflight=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}")

  local pr_state src dst web_url
  IFS=$'\t' read -r pr_state src dst web_url <<<"$(printf '%s' "$preflight" \
    | jq -r '[.state, .source.branch.name, .destination.branch.name, .links.html.href] | @tsv')"

  [ "$pr_state" = "OPEN" ] || _die "PR #${pr_id} cannot be merged — current state: ${pr_state}"

  local payload
  payload=$(jq -n \
    --arg     type     "pullrequest_merge_parameters" \
    --arg     strategy "$strategy" \
    --argjson close    "$close_branch" \
    --arg     msg      "$message" \
    '{type: $type, merge_strategy: $strategy, close_source_branch: $close}
     + (if $msg == "" then {} else {message: $msg} end)')

  local resp
  resp=$(bb_api POST "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/merge" \
    --data "$payload")

  if [ "$json_out" = true ]; then
    printf '%s\n' "$resp"
    return
  fi

  printf '%bPR #%s merged%b (%s)\n' "$C_BOLD" "$pr_id" "$C_RESET" "$(colorize_state "MERGED")"
  printf 'Strategy: %s\n' "$strategy"
  printf 'Branch:   %s → %s\n' "$src" "$dst"
  printf 'URL:      %s\n' "$web_url"
}

# ---------------------------------------------------------------------------
# pr decline
# ---------------------------------------------------------------------------
pr_decline() {
  local pr_id="" json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=true; shift ;;
      -*)     echo "unknown flag: $1" >&2; exit 1 ;;
      *)      pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  # Reject non-OPEN PRs client-side so users get the actual state, not a 405.
  local preflight
  preflight=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}")

  local pr_state src dst web_url
  IFS=$'\t' read -r pr_state src dst web_url <<<"$(printf '%s' "$preflight" \
    | jq -r '[.state, .source.branch.name, .destination.branch.name, .links.html.href] | @tsv')"

  [ "$pr_state" = "OPEN" ] || _die "PR #${pr_id} cannot be declined — current state: ${pr_state}"

  local resp
  resp=$(bb_api POST "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/decline" \
    --data '{}')

  if [ "$json_out" = true ]; then
    printf '%s\n' "$resp"
    return
  fi

  printf '%bPR #%s declined%b (%s)\n' "$C_BOLD" "$pr_id" "$C_RESET" "$(colorize_state "DECLINED")"
  printf 'Branch:   %s → %s\n' "$src" "$dst"
  printf 'URL:      %s\n' "$web_url"
}

# ---------------------------------------------------------------------------
# Resolve a comma-separated reviewer list to a JSON array of uuid strings.
# Trims surrounding whitespace per entry (keeps internal spaces so display-name
# fragments like "Tze Yang" still match). Unresolvable names warn + skip,
# mirroring pr_create.
# ---------------------------------------------------------------------------
_resolve_csv_to_uuids() {
  local csv="$1"
  local out="[]" name uuid
  IFS=',' read -ra _names <<< "$csv"
  for name in "${_names[@]}"; do
    name="${name#"${name%%[![:space:]]*}"}"   # ltrim
    name="${name%"${name##*[![:space:]]}"}"   # rtrim
    [ -n "$name" ] || continue
    if uuid=$(resolve_reviewer_uuid "$name"); then
      out=$(printf '%s' "$out" | jq -c --arg u "$uuid" '. + [$u] | unique')
    else
      echo "warning: could not resolve reviewer '$name' — skipping" >&2
    fi
  done
  printf '%s' "$out"
}

# ---------------------------------------------------------------------------
# pr reviewers — manage reviewers on an EXISTING pull request.
#   bb pr reviewers <id>                       → print current reviewers
#   bb pr reviewers <id> --add a,b             → merge (dedupe) into current
#   bb pr reviewers <id> --remove c            → drop matching reviewers
#   bb pr reviewers <id> --set a,b             → replace the list entirely
# --add/--remove may combine; --set is exclusive.
# A PUT replaces the whole reviewer array, so we GET first and send title +
# description back unchanged to avoid blanking the PR body.
# ---------------------------------------------------------------------------
pr_reviewers() {
  local pr_id="" add_csv="" remove_csv="" set_csv=""
  local add_set=false remove_set=false set_set=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --add)    add_csv="$2";    add_set=true;    shift 2 ;;
      --remove) remove_csv="$2"; remove_set=true; shift 2 ;;
      --set)    set_csv="$2";    set_set=true;    shift 2 ;;
      -*)       echo "unknown flag: $1" >&2; usage_pr; exit 1 ;;
      *)        pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  # --set is exclusive of --add/--remove.
  if [ "$set_set" = true ] && { [ "$add_set" = true ] || [ "$remove_set" = true ]; }; then
    _die "--set cannot be combined with --add or --remove"
  fi

  # GET the PR — needed for current reviewers AND to preserve title/description.
  local pr_json
  pr_json=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}")

  # No flags → just print the current reviewers and exit.
  if [ "$add_set" = false ] && [ "$remove_set" = false ] && [ "$set_set" = false ]; then
    local names
    names=$(printf '%s' "$pr_json" | jq -r '[.reviewers[]?.display_name] | join(", ")')
    printf 'Reviewers: %s\n' "${names:-none}"
    return 0
  fi

  # Current reviewer uuids (the PUT body replaces this whole array).
  local final_uuids
  final_uuids=$(printf '%s' "$pr_json" | jq -c '[.reviewers[]?.uuid]')

  if [ "$set_set" = true ]; then
    final_uuids=$(_resolve_csv_to_uuids "$set_csv")
  else
    if [ "$add_set" = true ]; then
      local add_uuids
      add_uuids=$(_resolve_csv_to_uuids "$add_csv")
      final_uuids=$(jq -cn --argjson a "$final_uuids" --argjson b "$add_uuids" '($a + $b) | unique')
    fi
    if [ "$remove_set" = true ]; then
      local rm_uuids
      rm_uuids=$(_resolve_csv_to_uuids "$remove_csv")
      final_uuids=$(jq -cn --argjson a "$final_uuids" --argjson b "$rm_uuids" '$a - $b')
    fi
  fi

  # {uuid: ...} objects; preserve title + description so the PUT doesn't blank them.
  local payload
  payload=$(printf '%s' "$pr_json" | jq -c --argjson uuids "$final_uuids" \
    '{title: .title, description: (.description // ""), reviewers: [$uuids[] | {uuid: .}]}')

  local resp
  resp=$(bb_api PUT "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}" \
    --data "$payload")

  local names
  names=$(printf '%s' "$resp" | jq -r '[.reviewers[]?.display_name] | join(", ")')
  printf '%bPR #%s reviewers updated%b\n' "$C_BOLD" "$pr_id" "$C_RESET"
  printf 'Reviewers: %s\n' "${names:-none}"
}

# ---------------------------------------------------------------------------
# pr approve — approve (or undo approval on) a pull request
# ---------------------------------------------------------------------------
pr_approve() {
  local pr_id="" undo=false json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --undo) undo=true;     shift ;;
      --json) json_out=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)      pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  local resp
  if [ "$undo" = true ]; then
    # DELETE /approve returns 204 No Content on success — body will be empty
    resp=$(bb_api DELETE "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/approve")
    if [ "$json_out" = true ]; then
      [ -n "$resp" ] && printf '%s\n' "$resp" || printf '{}\n'
      return
    fi
    printf 'PR #%s approval removed\n' "$pr_id"
  else
    resp=$(bb_api POST "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/approve" \
      --data '{}')
    if [ "$json_out" = true ]; then
      printf '%s\n' "$resp"
      return
    fi
    printf '%bPR #%s approved%b\n' "$C_BOLD" "$pr_id" "$C_RESET"
  fi
}

# ---------------------------------------------------------------------------
# pr request-changes — request changes on (or undo request on) a pull request
# ---------------------------------------------------------------------------
pr_request_changes() {
  local pr_id="" undo=false json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --undo) undo=true;     shift ;;
      --json) json_out=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)      pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  local resp
  if [ "$undo" = true ]; then
    # DELETE /request-changes returns 204 No Content on success — body will be empty
    resp=$(bb_api DELETE "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/request-changes")
    if [ "$json_out" = true ]; then
      [ -n "$resp" ] && printf '%s\n' "$resp" || printf '{}\n'
      return
    fi
    printf 'PR #%s request removed\n' "$pr_id"
  else
    resp=$(bb_api POST "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/request-changes" \
      --data '{}')
    if [ "$json_out" = true ]; then
      printf '%s\n' "$resp"
      return
    fi
    printf '%bPR #%s changes requested%b\n' "$C_BOLD" "$pr_id" "$C_RESET"
  fi
}

# ---------------------------------------------------------------------------
# pr checkout — check out the source branch of a pull request locally
# ---------------------------------------------------------------------------
pr_checkout() {
  local pr_id="" local_branch=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) local_branch="$2"; shift 2 ;;
      -*)       _die "unknown flag: $1" ;;
      *)        pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  local pr_json
  pr_json=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}")

  local src_branch src_full_name
  IFS=$'\t' read -r src_branch src_full_name <<<"$(printf '%s' "$pr_json" \
    | jq -r '[.source.branch.name, .source.repository.full_name] | @tsv')"

  local checkout_as="${local_branch:-$src_branch}"

  if [ "$src_full_name" = "${BB_WORKSPACE}/${BB_REPO}" ]; then
    # Same-repo PR: fetch from origin then check out (create tracking branch if missing)
    git fetch origin "$src_branch"
    if ! git checkout "$checkout_as" 2>/dev/null; then
      git checkout -b "$checkout_as" "origin/$src_branch"
    fi
  else
    # Cross-fork PR: source lives in a different repository
    _warn "PR #${pr_id} is a cross-fork PR (source: ${src_full_name})"
    local clone_url="https://bitbucket.org/${src_full_name}.git"
    printf 'Source: %s\n' "$clone_url"
    printf 'Fetching fork branch...\n'
    if git fetch "$clone_url" "${src_branch}:${checkout_as}"; then
      git checkout "$checkout_as"
    else
      printf '\nManual steps:\n' >&2
      printf '  git fetch %s %s:%s\n' "$clone_url" "$src_branch" "$checkout_as" >&2
      printf '  git checkout %s\n' "$checkout_as" >&2
      exit 1
    fi
  fi

  printf 'Checked out: %s\n' "$checkout_as"
}

# ---------------------------------------------------------------------------
# pr edit — update title, description, destination branch, or reviewers.
# GET-first then PUT so unspecified fields are NOT blanked (same pattern as
# pr_reviewers: PUT replaces the whole object, so we carry existing values).
# ---------------------------------------------------------------------------
pr_edit() {
  local pr_id="" title="" body="" body_file="" dest="" reviewers_csv=""
  local has_title=false has_body=false has_dest=false has_reviewers=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --title)     title="$2";         has_title=true;     shift 2 ;;
      --body)      body="$2";          has_body=true;      shift 2 ;;
      --body-file) body_file="$2";     has_body=true;      shift 2 ;;
      --dest)      dest="$2";          has_dest=true;      shift 2 ;;
      --reviewers) reviewers_csv="$2"; has_reviewers=true; shift 2 ;;
      -*)          _die "unknown flag: $1" ;;
      *)           pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  if [ "$has_title" = false ] && [ "$has_body" = false ] && \
     [ "$has_dest" = false ] && [ "$has_reviewers" = false ]; then
    _die "specify at least one of: --title, --body, --body-file, --dest, --reviewers"
  fi

  if [ -n "$body_file" ]; then
    [ -f "$body_file" ] || { echo "error: body file not found: $body_file" >&2; exit 1; }
    body=$(< "$body_file")
  fi

  # Resolve reviewer CSV → JSON array of UUID strings (mirrors pr_reviewers)
  local reviewers_uuids="[]"
  if [ "$has_reviewers" = true ]; then
    reviewers_uuids=$(_resolve_csv_to_uuids "$reviewers_csv")
  fi

  # GET current PR to carry forward any fields the user did not specify
  local pr_json
  pr_json=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}")

  # Build PUT payload — only override what was explicitly passed
  local payload
  payload=$(printf '%s' "$pr_json" | jq -c \
    --arg     new_title     "$title" \
    --argjson has_title     "$has_title" \
    --arg     new_desc      "$body" \
    --argjson has_body      "$has_body" \
    --arg     new_dest      "$dest" \
    --argjson has_dest      "$has_dest" \
    --argjson new_reviewers "$reviewers_uuids" \
    --argjson has_reviewers "$has_reviewers" \
    '{
      title:       (if $has_title     then $new_title else .title end),
      description: (if $has_body      then $new_desc  else (.description // "") end),
      destination: {branch: {name: (if $has_dest then $new_dest else .destination.branch.name end)}},
      reviewers:   (if $has_reviewers
                    then [$new_reviewers[] | {uuid: .}]
                    else [.reviewers[]?   | {uuid: .uuid}]
                   end)
    }')

  local resp
  resp=$(bb_api PUT "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}" \
    --data "$payload")

  local updated_title updated_state
  IFS=$'\t' read -r updated_title updated_state <<<"$(printf '%s' "$resp" \
    | jq -r '[.title, .state] | @tsv')"

  printf '%bPR #%s updated%b\n' "$C_BOLD" "$pr_id" "$C_RESET"
  printf 'Title: %s\n' "$updated_title"
  printf 'State: %s\n' "$(colorize_state "$updated_state")"
}

# ---------------------------------------------------------------------------
# api — escape hatch: call any Bitbucket API endpoint directly
# ---------------------------------------------------------------------------
api_cmd() {
  load_creds

  local method="" path="" body="" body_file="" json_out=false
  local data_set=false input_set=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --data)  body="$2";      data_set=true;  shift 2 ;;
      --input) body_file="$2"; input_set=true; shift 2 ;;
      --json)  json_out=true;  shift ;;
      -*)      _die "unknown flag: $1" ;;
      *)
        if [ -z "$method" ]; then
          method="$1"
        elif [ -z "$path" ]; then
          path="$1"
        else
          _die "unexpected argument: $1"
        fi
        shift
        ;;
    esac
  done

  [ -n "$method" ] || _die "METHOD is required. Usage: bb api <METHOD> <PATH> [--data JSON | --input FILE]"
  [ -n "$path"   ] || _die "PATH is required. Usage: bb api <METHOD> <PATH> [--data JSON | --input FILE]"
  [ "$data_set" = true ] && [ "$input_set" = true ] && _die "--data and --input are mutually exclusive"

  if [ "$input_set" = true ]; then
    [ -f "$body_file" ] || _die "input file not found: $body_file"
    body=$(< "$body_file")
  fi

  local resp
  if [ -n "$body" ]; then
    resp=$(bb_api "$method" "$path" --data "$body")
  else
    resp=$(bb_api "$method" "$path")
  fi

  if [ "$json_out" = true ]; then
    printf '%s\n' "$resp"
    return
  fi

  # Pretty-print if valid JSON; fall back to raw output for non-JSON endpoints
  if printf '%s' "$resp" | jq . 2>/dev/null; then
    :
  else
    printf '%s\n' "$resp"
  fi
}

# ---------------------------------------------------------------------------
# pr status — show open PR(s) for current branch with reviewer approval summary
# ---------------------------------------------------------------------------
pr_status() {
  local json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)      _die "unexpected argument: $1" ;;
    esac
  done

  local branch
  branch=$(git branch --show-current)
  [ -n "$branch" ] || _die "not on a branch (detached HEAD?)"

  # URL-encode the q filter: source.branch.name="<branch>"
  local q_encoded
  q_encoded=$(jq -rn --arg b "$branch" '@uri "source.branch.name=\"\($b)\""')

  local base_path="/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests"

  # Try server-side q filter first (avoid fetching all PRs); fall back to
  # client-side filter on non-2xx so this works even when q syntax is unsupported.
  local raw status body values
  raw=$(curl -sS -w $'\n%{http_code}' \
    -H "Content-Type: application/json" \
    -u "${BB_EMAIL}:${BB_TOKEN}" \
    "${BB_API_BASE}${base_path}?q=${q_encoded}&state=OPEN&pagelen=50") \
    || _die "curl failed (network error or bad TLS)"
  status="${raw##*$'\n'}"
  body="${raw%$'\n'*}"

  if [ "$status" -ge 200 ] && [ "$status" -lt 300 ]; then
    values=$(printf '%s' "$body" | jq -c '.values')
  else
    # q-filter rejected — fetch all OPEN PRs and filter client-side
    _warn "q-filter returned $status — using client-side branch filter"
    body=$(bb_api GET "${base_path}?state=OPEN&pagelen=50")
    values=$(printf '%s' "$body" | jq -c --arg b "$branch" '[.values[] | select(.source.branch.name == $b)]')
  fi

  if [ "$json_out" = true ]; then
    printf '%s\n' "$values"
    return
  fi

  local count
  count=$(printf '%s' "$values" | jq 'length')
  if [ "$count" -eq 0 ]; then
    printf "No open PR for branch '%s'.\n" "$branch"
    return 0
  fi

  # Print PR summary + per-reviewer approval state
  # Encode reviewers as "name|state" pairs joined by ";" so we can post-process in shell
  printf '%s' "$values" | jq -r '.[] | [
    (.id | tostring),
    .state,
    (.title | if length > 55 then .[0:55] + "…" else . end),
    ([.participants[] | select(.role == "REVIEWER") |
      "\(.user.display_name)|\(if .approved then "approved" elif .state == "changes_requested" then "changes_requested" else "pending" end)"
    ] | join(";"))
  ] | @tsv' | while IFS=$'\t' read -r pr_id st title reviewers; do
    printf '%b#%-5s%b  %-12s  %s\n' "$C_BOLD" "$pr_id" "$C_RESET" "$(colorize_state "$st")" "$title"
    if [ -n "$reviewers" ]; then
      IFS=';' read -ra rv_arr <<< "$reviewers"
      for rv in "${rv_arr[@]}"; do
        rv_name="${rv%%|*}"
        rv_st="${rv##*|}"
        case "$rv_st" in
          approved)           mark="✓" ;;
          changes_requested)  mark="✗" ;;
          *)                  mark="?" ;;
        esac
        printf '  %s %s\n' "$mark" "$rv_name"
      done
    fi
  done
}

# ---------------------------------------------------------------------------
# pr commits — list commits in a pull request
# ---------------------------------------------------------------------------
pr_commits() {
  local pr_id="" json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)      pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  local resp
  resp=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/commits")

  if [ "$json_out" = true ]; then
    printf '%s\n' "$(printf '%s' "$resp" | jq -c '.values')"
    return
  fi

  printf '%s' "$resp" | jq -r '.values[] | [
    .hash[0:7],
    (.author.user.display_name // (.author.raw | gsub(" <.*>$"; ""))),
    (.message | split("\n")[0] | if length > 60 then .[0:60] + "…" else . end)
  ] | @tsv' | while IFS=$'\t' read -r hash author msg; do
    printf '%b%s%b  %-25s  %s\n' "$C_GRAY" "$hash" "$C_RESET" "$author" "$msg"
  done
}

# ---------------------------------------------------------------------------
# pr files — list files changed in a pull request (diffstat)
# ---------------------------------------------------------------------------
pr_files() {
  local pr_id="" json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)      pr_id="$1"; shift ;;
    esac
  done

  [ -n "$pr_id" ] || { echo "error: PR id is required" >&2; exit 1; }

  local resp
  resp=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pullrequests/${pr_id}/diffstat?pagelen=100")

  if [ "$json_out" = true ]; then
    printf '%s\n' "$(printf '%s' "$resp" | jq -c '.values')"
    return
  fi

  printf '%s' "$resp" | jq -r '.values[] | [
    .status,
    ("+\(.lines_added // 0)/-\(.lines_removed // 0)"),
    (.new.path // .old.path)
  ] | @tsv' | while IFS=$'\t' read -r status changes path; do
    case "$status" in
      added)   color="$C_GREEN" ;;
      removed) color="$C_RED"   ;;
      *)       color="$C_RESET" ;;
    esac
    printf '%b%-10s%b  %-14s  %s\n' "$color" "$status" "$C_RESET" "$changes" "$path"
  done
}

# ---------------------------------------------------------------------------
# repo view — show repository details
# ---------------------------------------------------------------------------
repo_view() {
  local ws="" repo_slug="" json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)
        if [[ "$1" == */* ]]; then
          ws="${1%%/*}"
          repo_slug="${1#*/}"
        else
          _die "expected <workspace/repo>, got: $1"
        fi
        shift
        ;;
    esac
  done

  # Fall back to current repo when no arg given
  if [ -z "$ws" ]; then
    detect_repo
    ws="$BB_WORKSPACE"
    repo_slug="$BB_REPO"
  fi

  local resp
  resp=$(bb_api GET "/repositories/${ws}/${repo_slug}")

  if [ "$json_out" = true ]; then
    printf '%s\n' "$resp"
    return
  fi

  local full_name desc vis mainbranch size updated_on web_url
  IFS=$'\t' read -r full_name desc vis mainbranch size updated_on web_url <<<"$(printf '%s' "$resp" \
    | jq -r '[
        .full_name,
        (.description // "—"),
        (if .is_private then "private" else "public" end),
        (.mainbranch.name // "—"),
        (.size | tostring),
        .updated_on,
        .links.html.href
      ] | @tsv')"

  printf '%b%s%b\n' "$C_BOLD" "$full_name" "$C_RESET"
  printf 'Description:  %s\n' "$desc"
  printf 'Visibility:   %s\n' "$vis"
  printf 'Main branch:  %s\n' "$mainbranch"
  printf 'Size:         %s bytes\n' "$size"
  printf 'Updated:      %s\n' "$updated_on"
  printf 'URL:          %s\n' "$web_url"
}

# ---------------------------------------------------------------------------
# repo list — list repositories in a workspace
# ---------------------------------------------------------------------------
repo_list() {
  local ws="" json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)      ws="$1"; shift ;;
    esac
  done

  # Workspace: arg → try_detect → die
  if [ -z "$ws" ]; then
    if try_detect_workspace_slug; then
      ws="$DETECTED_WORKSPACE"
    else
      _die "workspace required: bb repo list <workspace>"
    fi
  fi

  local resp
  resp=$(bb_api GET "/repositories/${ws}?pagelen=50&role=member&sort=-updated_on")

  if [ "$json_out" = true ]; then
    printf '%s\n' "$(printf '%s' "$resp" | jq -c '.values')"
    return
  fi

  printf '%s' "$resp" | jq -r '.values[] | [
    .full_name,
    (if .is_private then "private" else "public" end),
    (.updated_on[0:10]),
    (.description // "" | if length > 40 then .[0:40] + "…" else . end)
  ] | @tsv' | while IFS=$'\t' read -r full_name vis updated desc; do
    printf '%-45s  %-8s  %-12s  %s\n' "$full_name" "$vis" "$updated" "$desc"
  done
}

# ---------------------------------------------------------------------------
# repo clone — clone a repository by workspace/repo slug
# ---------------------------------------------------------------------------
repo_clone() {
  local ws="" repo_slug="" use_ssh=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --ssh)  use_ssh=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)
        if [[ "$1" == */* ]]; then
          ws="${1%%/*}"
          repo_slug="${1#*/}"
        else
          _die "expected <workspace/repo>, got: $1"
        fi
        shift
        ;;
    esac
  done

  [ -n "$ws" ] || _die "workspace/repo is required: bb repo clone <workspace/repo>"

  local resp
  resp=$(bb_api GET "/repositories/${ws}/${repo_slug}")

  local clone_url
  if [ "$use_ssh" = true ]; then
    clone_url=$(printf '%s' "$resp" | jq -r '.links.clone[] | select(.name == "ssh") | .href')
  else
    clone_url=$(printf '%s' "$resp" | jq -r '.links.clone[] | select(.name == "https") | .href')
  fi

  [ -n "$clone_url" ] || _die "could not find clone URL for ${ws}/${repo_slug}"

  printf 'Cloning %s\n' "$clone_url"
  git clone "$clone_url"
}

# ---------------------------------------------------------------------------
# repo create — create a new repository in a workspace (mutates remote;
# prompts for confirmation unless --yes/-y is passed for scripting)
# ---------------------------------------------------------------------------
repo_create() {
  local name="" ws="" project_key="" description="" is_private=false yes=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --workspace)   ws="$2";           shift 2 ;;
      --private)     is_private=true;   shift   ;;
      --project)     project_key="$2";  shift 2 ;;
      --description) description="$2";  shift 2 ;;
      --yes|-y)      yes=true;          shift   ;;
      -*)            _die "unknown flag: $1" ;;
      *)
        [ -z "$name" ] || _die "unexpected argument: $1"
        name="$1"; shift
        ;;
    esac
  done

  [ -n "$name" ] || _die "repo name is required: bb repo create <name> [--workspace WS]"

  # Workspace: --workspace → try_detect → die
  if [ -z "$ws" ]; then
    if try_detect_workspace_slug; then
      ws="$DETECTED_WORKSPACE"
    else
      _die "workspace required: use --workspace WS"
    fi
  fi

  # Confirmation prompt (unless --yes/-y skips for scripting)
  if [ "$yes" = false ]; then
    local vis_label
    vis_label=$([ "$is_private" = true ] && echo "private" || echo "public")
    local proj_label=""
    [ -n "$project_key" ] && proj_label="  project=${project_key}"
    printf 'Will create: %s/%s (%s)%s\n' "$ws" "$name" "$vis_label" "$proj_label"
    printf 'Create this repository? [y/N]: '
    read -r reply
    if ! printf '%s' "$reply" | grep -qE '^[Yy]$'; then
      echo "Aborted."
      return
    fi
  fi

  # Build payload with jq — never string-concat user input into JSON
  local payload
  payload=$(jq -n \
    --arg     scm     "git" \
    --argjson private "$is_private" \
    --arg     desc    "$description" \
    --arg     proj    "$project_key" \
    '{scm: $scm, is_private: $private}
     + (if $desc != "" then {description: $desc} else {} end)
     + (if $proj != "" then {project: {key: $proj}} else {} end)')

  local resp
  resp=$(bb_api POST "/repositories/${ws}/${name}" --data "$payload")

  local full_name clone_url web_url
  full_name=$(printf '%s' "$resp" | jq -r '.full_name')
  clone_url=$(printf '%s' "$resp" | jq -r '.links.clone[] | select(.name == "https") | .href')
  web_url=$(printf '%s' "$resp"   | jq -r '.links.html.href')

  printf '%bRepository created%b\n' "$C_BOLD" "$C_RESET"
  printf 'Name:  %s\n' "$full_name"
  printf 'URL:   %s\n' "$web_url"
  printf 'Clone: %s\n' "$clone_url"
}

# ---------------------------------------------------------------------------
# repo dispatch
# ---------------------------------------------------------------------------
repo_dispatch() {
  local subcmd="${1:-}"
  [ -n "$subcmd" ] || { usage_repo; exit 1; }
  shift

  load_creds

  case "$subcmd" in
    view)   repo_view   "$@" ;;
    list)   repo_list   "$@" ;;
    clone)  repo_clone  "$@" ;;
    create) repo_create "$@" ;;
    *)
      echo "error: unknown repo subcommand '$subcmd'" >&2
      usage_repo
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# browse — open the current repo (or a file path within it) in the browser
# ---------------------------------------------------------------------------
browse_cmd() {
  local path="" branch=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) branch="$2"; shift 2 ;;
      -*)       _die "unknown flag: $1" ;;
      *)        path="$1"; shift ;;
    esac
  done

  load_creds
  detect_repo

  local url
  if [ -z "$path" ]; then
    url="https://bitbucket.org/${BB_WORKSPACE}/${BB_REPO}"
  else
    # Resolve branch: --branch → current git branch → repo default branch
    if [ -z "$branch" ]; then
      branch=$(git branch --show-current 2>/dev/null || true)
    fi
    if [ -z "$branch" ]; then
      branch=$(get_default_branch)
    fi

    # URL-encode each path segment individually then rejoin with /
    local encoded_path="" seg encoded_seg
    IFS='/' read -ra path_segs <<< "$path"
    for seg in "${path_segs[@]}"; do
      encoded_seg=$(jq -rn --arg s "$seg" '@uri $s')
      encoded_path="${encoded_path:+${encoded_path}/}${encoded_seg}"
    done

    local encoded_branch
    encoded_branch=$(jq -rn --arg b "$branch" '@uri $b')

    url="https://bitbucket.org/${BB_WORKSPACE}/${BB_REPO}/src/${encoded_branch}/${encoded_path}"
  fi

  _open_url "$url"
  printf 'Opened: %s\n' "$url"
}

# ---------------------------------------------------------------------------
# pipeline list — list recent pipelines for the current repo
# ---------------------------------------------------------------------------
pipeline_list() {
  local json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)      _die "unexpected argument: $1" ;;
    esac
  done

  local resp
  resp=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pipelines/?sort=-created_on&pagelen=20")

  if [ "$json_out" = true ]; then
    printf '%s\n' "$(printf '%s' "$resp" | jq -c '.values')"
    return
  fi

  printf '%s' "$resp" | jq -r '.values[] | [
    (.build_number | tostring),
    (.state.name // "?"),
    (.state.result.name // "—"),
    (.target.ref_name // (.target.commit.hash[0:8] // "—")),
    (.created_on[0:10])
  ] | @tsv' | while IFS=$'\t' read -r build_num state result ref created; do
    local color
    case "$result" in
      SUCCESSFUL) color="$C_GREEN"  ;;
      FAILED)     color="$C_RED"    ;;
      STOPPED)    color="$C_GRAY"   ;;
      *)
        case "$state" in
          IN_PROGRESS|PENDING) color="$C_YELLOW" ;;
          *)                   color="$C_GRAY"   ;;
        esac
        ;;
    esac
    local label
    if [ "$result" != "—" ]; then
      label="${state}/${result}"
    else
      label="$state"
    fi
    printf '%b#%-6s%b  %-30s  %-25s  %s\n' \
      "$C_BOLD" "$build_num" "$C_RESET" \
      "$(printf '%b%s%b' "$color" "$label" "$C_RESET")" \
      "$ref" "$created"
  done
}

# ---------------------------------------------------------------------------
# pipeline view — show pipeline details and its steps
# ---------------------------------------------------------------------------
pipeline_view() {
  local id="" json_out=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=true; shift ;;
      -*)     _die "unknown flag: $1" ;;
      *)      id="$1"; shift ;;
    esac
  done

  [ -n "$id" ] || _die "pipeline id or build number is required"

  local resp
  resp=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pipelines/${id}")

  if [ "$json_out" = true ]; then
    printf '%s\n' "$resp"
    return
  fi

  local build_num state result ref creator created duration
  IFS=$'\t' read -r build_num state result ref creator created duration <<<"$(printf '%s' "$resp" \
    | jq -r '[
        (.build_number | tostring),
        (.state.name // "?"),
        (.state.result.name // "—"),
        (.target.ref_name // "—"),
        (.creator.display_name // "—"),
        (.created_on // "—"),
        ((.duration_in_seconds // "—") | tostring)
      ] | @tsv')"

  printf '%bPipeline #%s%b\n' "$C_BOLD" "$build_num" "$C_RESET"
  printf 'State:    %s\n' "$state"
  printf 'Result:   %s\n' "$result"
  printf 'Ref:      %s\n' "$ref"
  printf 'Creator:  %s\n' "$creator"
  printf 'Created:  %s\n' "$created"
  printf 'Duration: %ss\n' "$duration"

  # List steps with UUIDs so the user can copy them for `pipeline logs`
  local steps_resp
  steps_resp=$(bb_api GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pipelines/${id}/steps/")

  printf '\nSteps:\n'
  printf '%s' "$steps_resp" | jq -r '.values[] | [
    (.name // "(unnamed)"),
    (.state.name // "?"),
    (.state.result.name // "—"),
    .uuid
  ] | @tsv' | while IFS=$'\t' read -r name st res uuid; do
    printf '  %-35s  %-15s  %-12s  %s\n' "$name" "$st" "$res" "$uuid"
  done
}

# ---------------------------------------------------------------------------
# pipeline logs — fetch raw log for a pipeline step (text/plain endpoint)
# ---------------------------------------------------------------------------
pipeline_logs() {
  local pipeline_id="" step_uuid=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -*)
        _die "unknown flag: $1" ;;
      *)
        if [ -z "$pipeline_id" ]; then
          pipeline_id="$1"
        elif [ -z "$step_uuid" ]; then
          step_uuid="$1"
        else
          _die "unexpected argument: $1"
        fi
        shift
        ;;
    esac
  done

  [ -n "$pipeline_id" ] || _die "pipeline id is required. Usage: bb pipeline logs <pipeline_id> <step_uuid>"
  [ -n "$step_uuid" ]   || _die "step uuid is required. Usage: bb pipeline logs <pipeline_id> <step_uuid>"

  # Log endpoint returns text/plain — bb_api_raw skips the JSON Content-Type (same as pr_diff)
  bb_api_raw GET "/repositories/${BB_WORKSPACE}/${BB_REPO}/pipelines/${pipeline_id}/steps/${step_uuid}/log"
}

# ---------------------------------------------------------------------------
# pipeline run — trigger a pipeline (MUTATES — prompts for confirmation)
# ---------------------------------------------------------------------------
pipeline_run() {
  local branch="" pattern="" yes=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --branch)  branch="$2";  shift 2 ;;
      --pattern) pattern="$2"; shift 2 ;;
      --yes|-y)  yes=true;     shift   ;;
      -*)        _die "unknown flag: $1" ;;
      *)         _die "unexpected argument: $1" ;;
    esac
  done

  # Resolve branch: --branch → current git branch → repo default branch
  if [ -z "$branch" ]; then
    branch=$(git branch --show-current 2>/dev/null || true)
  fi
  if [ -z "$branch" ]; then
    branch=$(get_default_branch)
  fi

  # Confirmation prompt (mirrors repo_create); --yes/-y bypasses for scripting
  if [ "$yes" = false ]; then
    local label="branch=${branch}"
    [ -n "$pattern" ] && label="${label}, pattern=${pattern}"
    printf 'Will trigger pipeline: %s/%s (%s)\n' "$BB_WORKSPACE" "$BB_REPO" "$label"
    printf 'Trigger this pipeline? [y/N]: '
    read -r reply
    if ! printf '%s' "$reply" | grep -qE '^[Yy]$'; then
      echo "Aborted."
      return
    fi
  fi

  # Build payload with jq — no string-concat of user input into JSON
  local payload
  if [ -n "$pattern" ]; then
    payload=$(jq -n \
      --arg branch  "$branch" \
      --arg pattern "$pattern" \
      '{target: {ref_type: "branch", type: "pipeline_ref_target", ref_name: $branch,
         selector: {type: "custom", pattern: $pattern}}}')
  else
    payload=$(jq -n \
      --arg branch "$branch" \
      '{target: {ref_type: "branch", type: "pipeline_ref_target", ref_name: $branch}}')
  fi

  local resp
  resp=$(bb_api POST "/repositories/${BB_WORKSPACE}/${BB_REPO}/pipelines/" --data "$payload")

  local build_num state html_url
  IFS=$'\t' read -r build_num state html_url <<<"$(printf '%s' "$resp" \
    | jq -r --arg ws "$BB_WORKSPACE" --arg repo "$BB_REPO" \
      '[
        (.build_number | tostring),
        (.state.name // "?"),
        (.links.html.href // ("https://bitbucket.org/" + $ws + "/" + $repo + "/pipelines/results/" + (.build_number | tostring)))
      ] | @tsv')"

  printf '%bPipeline #%s triggered%b\n' "$C_BOLD" "$build_num" "$C_RESET"
  printf 'State:  %s\n' "$state"
  printf 'Branch: %s\n' "$branch"
  printf 'URL:    %s\n' "$html_url"
}

# ---------------------------------------------------------------------------
# pipeline dispatch
# ---------------------------------------------------------------------------
pipeline_dispatch() {
  local subcmd="${1:-}"
  [ -n "$subcmd" ] || { usage_pipeline; exit 1; }
  shift

  load_creds
  detect_repo

  case "$subcmd" in
    list) pipeline_list "$@" ;;
    view) pipeline_view "$@" ;;
    logs) pipeline_logs "$@" ;;
    run)  pipeline_run  "$@" ;;
    *)
      echo "error: unknown pipeline subcommand '$subcmd'" >&2
      usage_pipeline
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# completion — emit static shell completion script (no creds, no repo needed)
# ---------------------------------------------------------------------------
_completion_bash() {
  cat <<'BASH_COMPLETION'
# bb bash completion
# Add to ~/.bashrc:
#   eval "$(bb completion bash)"
# Or write to a file and source it:
#   bb completion bash > ~/.bb-completion.bash && source ~/.bb-completion.bash

_bb_completion() {
  local cur prev words cword
  _init_completion 2>/dev/null || {
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    words=("${COMP_WORDS[@]}")
    cword="$COMP_CWORD"
  }

  local top_cmds="auth pr repo pipeline api browse completion help version"

  if [ "$cword" -eq 1 ]; then
    COMPREPLY=($(compgen -W "$top_cmds" -- "$cur"))
    return
  fi

  case "${words[1]}" in
    auth)
      COMPREPLY=($(compgen -W "login status logout" -- "$cur"))
      ;;
    pr)
      COMPREPLY=($(compgen -W "create list view comment diff checks open merge decline reviewers approve request-changes checkout edit status commits files" -- "$cur"))
      ;;
    repo)
      COMPREPLY=($(compgen -W "view list clone create" -- "$cur"))
      ;;
    pipeline)
      COMPREPLY=($(compgen -W "list view logs run" -- "$cur"))
      ;;
    completion)
      COMPREPLY=($(compgen -W "bash zsh" -- "$cur"))
      ;;
  esac
}

complete -F _bb_completion bb
BASH_COMPLETION
}

_completion_zsh() {
  cat <<'ZSH_COMPLETION'
#compdef bb
# bb zsh completion
# Add to ~/.zshrc:
#   eval "$(bb completion zsh)"
# Or write to a file on fpath:
#   bb completion zsh > "${fpath[1]}/_bb"

_bb() {
  local state line
  typeset -A opt_args

  _arguments \
    '1: :->command' \
    '*: :->args'

  case "$state" in
    command)
      local commands=(
        'auth:Manage authentication'
        'pr:Pull request commands'
        'repo:Repository commands'
        'pipeline:Pipeline/CI commands'
        'api:Call any Bitbucket API endpoint directly'
        'browse:Open repo or file path in browser'
        'completion:Print shell completion script'
        'help:Show usage'
        'version:Print version'
      )
      _describe 'command' commands
      ;;
    args)
      case "$line[1]" in
        auth)
          local subcmds=(
            'login:Interactive token setup'
            'status:Verify current credentials'
            'logout:Remove saved credentials'
          )
          _describe 'subcommand' subcmds
          ;;
        pr)
          local subcmds=(
            'create:Open a new pull request'
            'list:List pull requests'
            'view:Show PR details'
            'comment:Post a comment on a PR'
            'diff:Show raw diff'
            'checks:Show build statuses'
            'open:Open PR URL in browser'
            'merge:Merge a pull request'
            'decline:Decline a pull request'
            'reviewers:Manage reviewers on a PR'
            'approve:Approve a PR'
            'request-changes:Request changes on a PR'
            'checkout:Check out PR source branch locally'
            'edit:Edit PR title/description/destination/reviewers'
            'status:Show open PRs for current branch'
            'commits:List commits in a PR'
            'files:List files changed in a PR'
          )
          _describe 'subcommand' subcmds
          ;;
        repo)
          local subcmds=(
            'view:Show repository details'
            'list:List repositories in a workspace'
            'clone:Clone a repository'
            'create:Create a new repository'
          )
          _describe 'subcommand' subcmds
          ;;
        pipeline)
          local subcmds=(
            'list:List recent pipelines'
            'view:Show pipeline details and steps'
            'logs:Fetch raw log for a pipeline step'
            'run:Trigger a pipeline'
          )
          _describe 'subcommand' subcmds
          ;;
        completion)
          local shells=('bash:Bash completion script' 'zsh:Zsh completion script')
          _describe 'shell' shells
          ;;
      esac
      ;;
  esac
}

_bb "$@"
ZSH_COMPLETION
}

completion_cmd() {
  local shell="${1:-}"
  [ -n "$shell" ] || _die "shell is required. Usage: bb completion bash|zsh"

  case "$shell" in
    bash) _completion_bash ;;
    zsh)  _completion_zsh  ;;
    *)    _die "unknown shell '$shell'. Supported: bash, zsh" ;;
  esac
}

# ---------------------------------------------------------------------------
# pr dispatch
# ---------------------------------------------------------------------------
pr_dispatch() {
  local subcmd="${1:-}"
  [ -n "$subcmd" ] || { usage_pr; exit 1; }
  shift

  detect_repo
  load_creds

  case "$subcmd" in
    create)  pr_create  "$@" ;;
    list)    pr_list    "$@" ;;
    view)    pr_view    "$@" ;;
    comment) pr_comment "$@" ;;
    diff)    pr_diff    "$@" ;;
    checks)  pr_checks  "$@" ;;
    open)    pr_open    "$@" ;;
    merge)   pr_merge   "$@" ;;
    decline)         pr_decline         "$@" ;;
    reviewers)       pr_reviewers       "$@" ;;
    approve)         pr_approve         "$@" ;;
    request-changes) pr_request_changes "$@" ;;
    checkout)        pr_checkout        "$@" ;;
    edit)            pr_edit            "$@" ;;
    status)          pr_status          "$@" ;;
    commits)         pr_commits         "$@" ;;
    files)           pr_files           "$@" ;;
    *)
      echo "error: unknown pr subcommand '$subcmd'" >&2
      usage_pr
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage_pipeline() {
  cat >&2 <<'EOF'
Usage:
  bb pipeline list                          [--json]
  bb pipeline view  <id>                    [--json]
  bb pipeline logs  <pipeline_id> <step_uuid>
  bb pipeline run   [--branch B] [--pattern CUSTOM] [--yes]
EOF
}

usage_pr() {
  cat >&2 <<'EOF'
Usage:
  bb pr create   --title TITLE [--body BODY | --body-file FILE] [--dest BRANCH] [--draft] [--reviewers user1,user2] [--fill] [--web]
  bb pr list     [--state open|merged|declined|all] [--json]
  bb pr view     <id> [--json]
  bb pr comment  <id> (--body BODY | --body-file FILE)
  bb pr diff     <id>
  bb pr checks   <id>
  bb pr open     <id>
  bb pr merge    <id> [--merge|--squash|--fast-forward] [--delete-branch] [--message MSG] [--json]
  bb pr decline          <id> [--json]
  bb pr reviewers        <id> [--add user1,user2] [--remove user3] [--set user1,user2]
  bb pr approve          <id> [--undo] [--json]
  bb pr request-changes  <id> [--undo] [--json]
  bb pr checkout         <id> [--branch NAME]
  bb pr edit             <id> [--title T] [--body B | --body-file F] [--dest BRANCH] [--reviewers user1,user2]
  bb pr status           [--json]
  bb pr commits          <id> [--json]
  bb pr files            <id> [--json]
EOF
}

usage_auth() {
  cat >&2 <<'EOF'
Usage:
  bb auth login    Interactive token setup
  bb auth status   Verify current credentials
  bb auth logout   Remove saved credentials
EOF
}

usage_repo() {
  cat >&2 <<'EOF'
Usage:
  bb repo view   [ws/repo] [--json]
  bb repo list   [ws] [--json]
  bb repo clone  <ws/repo> [--ssh]
  bb repo create <name> [--workspace WS] [--private] [--project KEY] [--description D] [--yes]
EOF
}

usage_main() {
  cat <<EOF
bb — gh-style CLI for Bitbucket Cloud  (v${VERSION})

Usage:
  bb <command> [subcommand] [flags]
  bb help
  bb version

Auth subcommands:
  login    Interactive token setup
  status   Verify current credentials
  logout   Remove saved credentials

PR subcommands:
  create   Open a new pull request (--fill derives title/body from commits; --web opens browser)
  list     List pull requests
  view     Show PR details
  comment  Post a comment on a PR
  diff     Show PR diff
  checks   Show PR build statuses
  open     Open PR in browser
  merge    Merge a pull request
  decline  Decline a pull request
  reviewers       Add/remove/set reviewers on a PR
  approve         Approve a pull request
  request-changes Request changes on a pull request
  checkout        Check out the PR source branch locally
  edit            Edit PR title, description, destination, or reviewers
  status          Show open PR(s) for current branch with reviewer approval state
  commits         List commits in a pull request
  files           List files changed in a pull request

Repo subcommands:
  view     Show repository details
  list     List repositories in a workspace
  clone    Clone a repository
  create   Create a new repository (prompts for confirmation)

Pipeline subcommands:
  list     List recent pipelines (sorted newest-first)
  view     Show pipeline details and step list (UUIDs for logs)
  logs     Fetch raw log for a pipeline step
  run      Trigger a pipeline (prompts for confirmation; --yes bypasses)

Other commands:
  api             Call any Bitbucket API endpoint directly
  browse          Open the current repo (or a file path) in the browser
  completion      Print shell completion script (bash|zsh)

Note (v0.1):
  List commands show the first 50 results only (no pagination yet).
EOF
}

# ---------------------------------------------------------------------------
# Main entrypoint
# ---------------------------------------------------------------------------
cmd="${1:-}"
[ -n "$cmd" ] || { usage_main; exit 0; }
shift

# Fast paths — version/help/completion shouldn't pay for dependency probes
case "$cmd" in
  help)       usage_main; exit 0 ;;
  version)    printf '%s\n' "$VERSION"; exit 0 ;;
  completion) completion_cmd "$@"; exit 0 ;;
esac

check_deps

case "$cmd" in
  pr)       pr_dispatch       "$@" ;;
  auth)     auth_dispatch     "$@" ;;
  api)      api_cmd           "$@" ;;
  repo)     repo_dispatch     "$@" ;;
  browse)   browse_cmd        "$@" ;;
  pipeline) pipeline_dispatch "$@" ;;
  *)
    echo "error: unknown command '$cmd'" >&2
    usage_main >&2
    exit 1
    ;;
esac
