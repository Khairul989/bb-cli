# Atlassian account email (the email you log into Bitbucket with)
BB_EMAIL=you@example.com

# Scoped API token — NOT an app password.
# Generate at: https://id.atlassian.com → Security → API tokens
# Required scopes: Pull requests (Read + Write), Repositories (Read), Account (Read)
#
# Note: Atlassian app passwords are deprecated as of June 2026.
# Use scoped API tokens only.
BB_TOKEN=your_api_token_here
